# Runtime
ATLASGPT_ENV=development
LOG_LEVEL=INFO

# Frontend origins (comma-separated; use your deployed HTTPS origin in production)
FRONTEND_ORIGINS=http://localhost:5173
# COOKIE_SECURE defaults to true when ATLASGPT_ENV=production
# COOKIE_SECURE=true

# Ollama inference service
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Persistent ingestion job database
ATLASGPT_JOBS_DB=data/jobs.db

# Optional Telegram interface
TELEGRAM_BOT_TOKEN=
CONVERSATION_HISTORY_LIMIT=10

# Fair-use limits (adjust before launch)
GUEST_CHAT_DAILY_LIMIT=10
GUEST_UPLOAD_MONTHLY_LIMIT=1
FREE_CHAT_DAILY_LIMIT=50
FREE_UPLOAD_MONTHLY_LIMIT=10
PAID_CHAT_DAILY_LIMIT=1000
PAID_UPLOAD_MONTHLY_LIMIT=100
